[Desktop Entry]
Type=Application
Name=Oracle Vector
GenericName=Vector Graphics Editor
Comment=Draw and edit vector illustrations, SVG and PDF
Exec=oracle-vector %F
TryExec=oracle-vector
Icon=app.oracle.oracle-vector
Terminal=false
StartupNotify=true
StartupWMClass=app.oracle.oracle-vector
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=vector;illustration;svg;pdf;drawing;bezier;
# MimeType lists the formats File › Open reads that Info.plist.in declares for macOS. The type of .ai
# files is shared-mime-info's application/illustrator (brand-ok).
MimeType=image/svg+xml;application/pdf;application/x-oracle-vector;image/svg+xml-compressed;application/illustrator;application/x-ai-template;image/png;image/jpeg;image/gif;image/webp;image/tiff;image/bmp;application/x-oracle-vector-template;image/vnd.dxf;image/emf;image/wmf;image/x-eps;application/x-affinity;
